<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.springboot.springboothousemarket.Mapper.UsersMapper">

    <resultMap id="sysUserResultMap" type="com.springboot.springboothousemarket.Entity.Users">
        <id property="id" column="id"/>
        <result property="username" column="username"/>
        <result property="password" column="password"/>
        <result property="realName" column="real_name"/>
        <result property="role" column="role"/>
        <result property="phone" column="phone"/>
        <result property="avatar" column="avatar"/>
        <result property="status" column="status"/>
        <result property="createTime" column="register_time"/>
        <result property="updateTime" column="update_time"/>
        <result property="isDeleted" column="is_deleted"/>
    </resultMap>

    <select id="selectByUsername" parameterType="string" resultMap="sysUserResultMap">
        SELECT id,
               username,
               password,
               real_name,
               role,
               phone,
               avatar,
               status,
               register_time,
               update_time,
               is_deleted
        FROM sysuser
        WHERE username = #{username}
          AND is_deleted = 0
    </select>

</mapper>
