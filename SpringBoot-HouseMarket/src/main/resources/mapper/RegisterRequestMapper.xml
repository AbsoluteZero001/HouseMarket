<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.springboot.springboothousemarket.Mapper.RegisterRequestMapper">

    <resultMap id="BaseResultMap" type="com.springboot.springboothousemarket.dto.RegisterRequest">
        <result property="username" column="username"/>
        <result property="password" column="password"/>
        <result property="role" column="role"/>
        <result property="status" column="status"/>
    </resultMap>

    <insert id="register">
        INSERT INTO sysuser(username, password, role, status)
        VALUES (#{username}, #{password}, #{role}, #{status})
    </insert>

    <select id="findUserByUsernameAndPassword" resultMap="BaseResultMap">
        SELECT *
        FROM sysuser
        WHERE username = #{param1}
          AND password = #{param2}
    </select>

</mapper>
