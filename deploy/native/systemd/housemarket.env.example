# ============================================================
# HouseMarket systemd 环境变量文件
# 安装路径：/etc/housemarket/housemarket.env
# 权限建议：chmod 600，仅 root 可读
# ============================================================

# Java 安装路径（根据服务器实际路径修改）
JAVA_HOME=/usr/lib/jvm/java-21-openjdk-amd64

# JWT 密钥（生产必须设置！）
# 生成命令：openssl rand -base64 48
JWT_SECRET=

# 数据库密码（与 application-prod.yml 中一致）
# 注意：application-prod.yml 中已明文写密码时，这里可留空
SPRING_DATASOURCE_PASSWORD=changeme_strong_password

# Redis 密码（如未设置密码留空）
SPRING_DATA_REDIS_PASSWORD=

# 跨域白名单
APP_CORS_ALLOWED_ORIGINS=https://house.evezero.cn,https://www.house.evezero.cn

# Swagger
SWAGGER_ENABLED=false

# 数据库迁移（Flyway）：增量结构变更在应用启动时自动执行，不要再手工执行 SQL 脚本
FLYWAY_ENABLED=true

# 实名认证审核 SLA（小时）：超时未审核自动拒绝并通知申请人
IDENTITY_VERIFY_EXPIRE_HOURS=72
IDENTITY_VERIFY_EXPIRY_ENABLED=true

# 通知归档保留天数（已读 / 未读）
NOTIFICATION_ARCHIVE_ENABLED=true
NOTIFICATION_ARCHIVE_DAYS=90
NOTIFICATION_ARCHIVE_UNREAD_DAYS=365

# 登录/注册限流（用户名维度 / IP 维度 / 统计窗口秒数）
# 应用在 Nginx 之后，RATELIMIT_TRUST_PROXY_HEADERS 必须为 true
RATELIMIT_LOGIN_USER_LIMIT=5
RATELIMIT_LOGIN_IP_LIMIT=30
RATELIMIT_REGISTER_USER_LIMIT=5
RATELIMIT_REGISTER_IP_LIMIT=20
RATELIMIT_WINDOW_SECONDS=60
RATELIMIT_TRUST_PROXY_HEADERS=true
