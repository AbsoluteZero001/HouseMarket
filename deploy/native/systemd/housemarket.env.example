# ============================================================
# HouseMarket systemd 环境变量文件
# 安装路径：/etc/housemarket/housemarket.env
# 权限建议：chmod 600，仅 root 可读
# ============================================================

# Java 安装路径（根据服务器实际路径修改）
JAVA_HOME=/usr/lib/jvm/java-21-openjdk-amd64

# JWT 密钥（生产必须设置！）
# 生成命令：openssl rand -base64 48
JWT_SECRET=

# 数据库密码（与 application-prod.yml 中一致）
# 注意：application-prod.yml 中已明文写密码时，这里可留空
SPRING_DATASOURCE_PASSWORD=changeme_strong_password

# Redis 密码（如未设置密码留空）
SPRING_DATA_REDIS_PASSWORD=

# 跨域白名单
APP_CORS_ALLOWED_ORIGINS=https://house.evezero.cn,https://www.house.evezero.cn

# Swagger
SWAGGER_ENABLED=false
