# HouseMarket 生产环境变量模板（Docker 部署）
# 使用方法：复制本文件为 .env 并填入实际值，然后执行 docker compose up -d

# ============================================
# MySQL 配置
# 注意：MySQL 容器不映射宿主机端口，仅内部网络访问
# 必须设置强密码，缺失时 docker compose 会直接报错停止
# 生成建议：openssl rand -base64 16
# ============================================
MYSQL_ROOT_PASSWORD=<replace-with-strong-random-password>

# ============================================
# 前端宿主机端口（容器内 Nginx 监听 80，映射到宿主机 127.0.0.1:此端口）
# 宿主机 Nginx 反向代理到此端口，不可设为 80/443
# ============================================
FRONTEND_PORT=5173

# ============================================
# JWT 密钥（生产必须设置！）
# 生成命令：openssl rand -base64 48
# ============================================
JWT_SECRET=

# ============================================
# JWT 过期时间（小时）
# ============================================
JWT_EXPIRATION_HOURS=10

# ============================================
# 跨域白名单（生产环境务必改为真实域名）
# 多个域名用英文逗号分隔
# ============================================
APP_CORS_ALLOWED_ORIGINS=https://house.evezero.cn,https://www.house.evezero.cn

# ============================================
# Swagger（生产环境建议关闭）
# ============================================
SWAGGER_ENABLED=false

# ============================================
# 数据库迁移（Flyway）
# 增量结构变更在应用启动时自动执行，不要再手工执行 SQL 脚本。
# 仅在紧急情况下临时关闭（如需先手工修库），关闭后请自行确保结构已到位。
# ============================================
FLYWAY_ENABLED=true

# ============================================
# 实名认证审核 SLA
# 提交后超过该小时数仍没人审核，系统自动拒绝并通知申请人（用户可重新提交）。
# ============================================
IDENTITY_VERIFY_EXPIRE_HOURS=72
IDENTITY_VERIFY_EXPIRY_ENABLED=true

# ============================================
# 通知归档保留天数
# 已读通知保留 90 天，未读通知保留 365 天（避免用户还没看的消息被清掉）。
# ============================================
NOTIFICATION_ARCHIVE_ENABLED=true
NOTIFICATION_ARCHIVE_DAYS=90
NOTIFICATION_ARCHIVE_UNREAD_DAYS=365

# ============================================
# 登录/注册限流
# 用户名维度 / IP 维度（每分钟）/ 统计窗口秒数。
# 应用在 Nginx 之后时 RATELIMIT_TRUST_PROXY_HEADERS 必须为 true。
# ============================================
RATELIMIT_LOGIN_USER_LIMIT=5
RATELIMIT_LOGIN_IP_LIMIT=30
RATELIMIT_REGISTER_USER_LIMIT=5
RATELIMIT_REGISTER_IP_LIMIT=20
RATELIMIT_WINDOW_SECONDS=60
RATELIMIT_TRUST_PROXY_HEADERS=true
