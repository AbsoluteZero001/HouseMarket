<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.springboot.springboothousemarket.Mapper.RegisterRequestMapper">

    <resultMap id="BaseResultMap" type="com.springboot.springboothousemarket.dto.RegisterRequest">
        <id property="id" column="id"/>
        <result property="username" column="username"/>
        <result property="password" column="password"/>
        <result property="nickname" column="nickname"/>
        <result property="avatar" column="avatar"/>
        <result property="role" column="role"/>
        <result property="status" column="status"/>
        <result property="isDeleted" column="is_deleted"/>
    </resultMap>

    <insert id="register" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO sysuser(username, password, nickname, avatar, role, status)
        VALUES (#{username}, #{password}, #{nickname}, #{avatar}, #{role}, #{status})
    </insert>

    <select id="findUserByUsername" resultMap="BaseResultMap">
        SELECT id,
               username,
               password,
               nickname,
               avatar,
               role,
               status,
               is_deleted
        FROM sysuser
        WHERE username = #{username}
          AND is_deleted = 0
    </select>

</mapper>
